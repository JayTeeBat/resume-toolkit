{#
  The published landing page — what GitHub Pages serves at the site root.
  Self-contained by design: this is one small page, so its CSS lives inline
  rather than earning a second stylesheet to keep in sync with the theme's.
#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ resume.basics.name }} — Resume</title>
<meta name="description" content="{{ resume.basics.label }}">
{# Initials favicon, derived from the name so it never goes stale. Inline SVG
   data URI: no asset file to copy, nothing extra for Pages to serve. #}
{% set initials = (resume.basics.name.split() | map('first') | join(''))[:2] %}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%231f4e79'/%3E%3Ctext x='32' y='44' font-family='system-ui,sans-serif' font-size='30' font-weight='700' text-anchor='middle' fill='%23fff'%3E{{ initials }}%3C/text%3E%3C/svg%3E">
{# Link previews: this URL is what gets pasted into LinkedIn and messengers,
   and without og: tags those render it as a bare link. #}
{% set canonical = (resume.get('meta') or {}).get('canonical') %}
<meta property="og:type" content="profile">
<meta property="og:title" content="{{ resume.basics.name }} — Resume">
<meta property="og:description" content="{{ resume.basics.label }}">
{% if canonical %}
<meta property="og:url" content="{{ canonical }}">
<link rel="canonical" href="{{ canonical }}">
{% endif %}
<meta name="twitter:card" content="summary">
{# Pre-serialized schema.org/Person (see _json_ld) — what search engines read. #}
<script type="application/ld+json">{{ json_ld }}</script>
<style>
  :root {
    --bg:      #f4f6f8;
    --card:    #ffffff;
    --ink:     #1a1a1a;
    --soft:    #4a4a4a;
    --faint:   #767676;
    --accent:  #1f4e79;
    --rule:    #e2e5e9;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:     #14171a;
      --card:   #1d2125;
      --ink:    #e8eaed;
      --soft:   #b4b8bd;
      --faint:  #868b91;
      --accent: #7db3e0;
      --rule:   #2c3237;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 3rem 1.25rem 4rem;
    background: var(--bg);
    color: var(--ink);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  main { max-width: 34rem; margin: 0 auto; }

  h1 {
    margin: 0;
    font-size: 1.9rem;
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  .label { margin: .35rem 0 0; color: var(--soft); }
  .contact {
    margin: .6rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: .2rem .9rem;
    font-size: .85rem;
    color: var(--faint);
  }
  .contact a { color: var(--faint); }

  .card {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 1.15rem 1.25rem;
  }
  .card h2, .card h3 { margin: 0; }
  /* The primary cut leads: accent border, larger heading. */
  .primary-card {
    margin-top: 2.25rem;
    border: 2px solid var(--accent);
  }
  .primary-card h2 { font-size: 1.2rem; }
  /* Alternatives stay on offer but recede: no card fill, smaller type and
     outline-only buttons, so the eye lands on the primary cut first. */
  .alternatives { margin-top: 1.75rem; display: grid; gap: .75rem; }
  .alternatives-heading {
    margin: 0;
    font-size: .78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--faint);
  }
  .alternative { background: transparent; padding: .85rem 1.1rem; }
  .alternative h3 { font-size: .95rem; color: var(--soft); }
  .alternative .actions { margin-top: .7rem; }
  .alternative .btn.primary { background: transparent; color: var(--accent); }

  .actions { margin-top: .95rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  /* Standalone (single CV): no card around it, so it needs the cards' top gap. */
  .actions.solo { margin-top: 2.25rem; }
  .btn {
    display: inline-block;
    padding: .4rem .85rem;
    border-radius: 6px;
    border: 1px solid var(--accent);
    font-size: .85rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--accent);
  }
  .btn.primary { background: var(--accent); color: var(--card); }
  .size { align-self: center; font-size: .78rem; color: var(--faint); }

  footer {
    margin-top: 2.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: .8rem;
    color: var(--faint);
  }
  footer a { color: var(--faint); }
</style>
</head>
<body>
<main>

  {% set b = resume.basics %}
  <header>
    <h1>{{ b.name }}</h1>
    {% if b.label %}<p class="label">{{ b.label }}</p>{% endif %}
    <ul class="contact">
      {% if b.email %}<li><a href="mailto:{{ b.email }}">{{ b.email }}</a></li>{% endif %}
      {% if b.location and b.location | location %}<li>{{ b.location | location }}</li>{% endif %}
      {% for p in b.profiles or [] %}
        <li><a href="{{ p.url }}">{{ p.network }}</a></li>
      {% endfor %}
    </ul>
  </header>

  {# One macro for both layouts, so the buttons cannot drift apart: each is
     labelled by its file type alone. #}
  {% macro actions(c) -%}
  {% if c.html %}<a class="btn primary" href="{{ c.html }}">HTML</a>{% endif %}
      {% if c.pdf %}<a class="btn" href="{{ c.pdf }}" target="_blank" rel="noopener">PDF</a>{% endif %}
      {% if c.json %}<a class="btn" href="{{ c.json }}">JSON</a>{% endif %}
      {% if c.md %}<a class="btn" href="{{ c.md }}">Markdown</a>{% endif %}
      {% if c.pdf %}<span class="size">PDF · {{ c.size }}</span>{% endif %}
  {%- endmacro %}

  {# The first published variant in variants.toml is the primary cut: it
     leads, plainly, and is the one /resume.json and llms.txt point at. Cards
     carry the version name and its actions only: variant descriptions are
     notes for the CV's author and for llms.txt, not copy for visitors. A lone
     cut shows no name, just the actions. Any further published cuts follow
     as quieter alternatives, in file order, with their selected actions. #}
  {% set primary = cards[0] %}
  {% if cards | length == 1 %}
    <div class="actions solo">
      {{ actions(primary) }}
    </div>
  {% else %}
    <section class="card primary-card">
      <h2>{{ primary.name | title }} Version</h2>
      <div class="actions">
        {{ actions(primary) }}
      </div>
    </section>
    <section class="alternatives">
      <h2 class="alternatives-heading">Other versions</h2>
      {% for c in cards[1:] %}
      <section class="card alternative">
        <h3>{{ c.name | title }} Version</h3>
        <div class="actions">
          {{ actions(c) }}
        </div>
      </section>
      {% endfor %}
    </section>
  {% endif %}

  <footer>Updated {{ generated }}</footer>

</main>
</body>
</html>
